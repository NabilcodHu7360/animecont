# Normalize line endings so CRLF/LF differences stop showing up as phantom diffs.
* text=auto

# Text files: store with LF in the repo.
*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.cfg   text eol=lf
*.toml  text eol=lf
.gitignore   text eol=lf
.gitattributes text eol=lf

# Binary assets — never touch these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.wav   binary
*.mp3   binary
*.mp4   binary
*.m4a   binary
*.ogg   binary
*.onnx  binary
*.bin   binary
*.zip   binary
